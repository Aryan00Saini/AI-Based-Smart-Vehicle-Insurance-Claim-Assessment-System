# --- Persistence ---
DATABASE_URL=sqlite:///./data/claims.db

# --- JWT Security ---
# Generate a fresh 64-char key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string

# --- Object Storage ---
STORAGE_BACKEND=local

# Only needed if you switch STORAGE_BACKEND to "s3"
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vehicle-claims
S3_REGION_NAME=us-east-1
